{% from 'probes.yaml.j2' import probe %}
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ name }}
  labels:
    app.kubernetes.io/name: {{ name }}
    app.kubernetes.io/managed-by: inference-playbooks
spec:
  replicas: {{ replicas }}
  selector:
    matchLabels:
      app.kubernetes.io/name: {{ name }}
  template:
    metadata:
      labels:
        app.kubernetes.io/name: {{ name }}
    spec:
      securityContext:
        runAsNonRoot: true
        runAsUser: 65534
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: vllm
          image: {{ image }}
          command:
            - /bin/bash
            - -c
            - |
              vllm serve "$@"
            - --
          args:
            - {{ model_path | tojson }}
            - {{ ("--served-model-name=" ~ served_model_name) | tojson }}
{% for arg in args %}
{% if arg.value is defined and arg.value is not none %}
            - {{ (arg.flag ~ "=" ~ arg.value) | tojson }}
{% else %}
            - {{ arg.flag | tojson }}
{% endif %}
{% endfor %}
{% if tp > 1 %}
            - {{ ("--tensor-parallel-size=" ~ tp) | tojson }}
{% endif %}
{% if dp > 1 %}
            - {{ ("--data-parallel-size=" ~ dp) | tojson }}
{% endif %}
          env:
            - name: HF_TOKEN
              valueFrom:
                secretKeyRef:
                  name: hf-token
                  key: HF_TOKEN
{% for e in env %}
{% if e.value is defined %}
            - name: {{ e.name | tojson }}
              value: {{ e.value | tojson }}
{% elif e.value_from is defined %}
            - name: {{ e.name | tojson }}
              valueFrom: {{ e.value_from | tojson }}
{% endif %}
{% endfor %}
          ports:
            - name: http
              containerPort: {{ port }}
              protocol: TCP
          resources:
            requests:
              cpu: "{{ resources.requests.cpu | default('8') }}"
              memory: {{ resources.requests.memory | default('32Gi') }}
              nvidia.com/gpu: "{{ gpu_count }}"
            limits:
{% if resources.limits.cpu is defined or not weights %}
              cpu: "{{ resources.limits.cpu | default('8') }}"
{% endif %}
              memory: {{ resources.limits.memory | default('64Gi') }}
              nvidia.com/gpu: "{{ gpu_count }}"
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop:
                - ALL
{% for name, values in probes.items() %}
{{ probe(name, values) | trim | indent(10, true) }}
{% endfor %}
          volumeMounts:
            - name: hf-cache
              mountPath: /home/nobody/.cache
            - name: tmp
              mountPath: /tmp
{% if weights %}
            - name: model-weights
              mountPath: {{ weights.mount_path | tojson }}
              readOnly: {{ weights.read_only | tojson }}
{% endif %}
{% if use_shared_memory %}
            - name: dshm
              mountPath: /dev/shm
{% endif %}
      volumes:
        - name: hf-cache
          emptyDir: {}
        - name: tmp
          emptyDir: {}
{% if weights %}
        - name: model-weights
          persistentVolumeClaim:
            claimName: {{ weights.name | tojson }}
            readOnly: {{ weights.read_only | tojson }}
{% endif %}
{% if use_shared_memory %}
        - name: dshm
          emptyDir:
            medium: Memory
            sizeLimit: {{ shared_memory }}
{% endif %}
