{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/openshift-psap/inference-playbooks/schema/hardware-profile.schema.json",
  "title": "Inference Playbook Hardware Profile",
  "type": "object",
  "required": [
    "schema_version", "profile_id", "profile_revision", "kind",
    "accelerator_key", "accelerators", "correction_log"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "profile_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "profile_revision": {"type": "integer", "minimum": 1},
    "kind": {"const": "hardware-profile"},
    "accelerator_key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*-x[1-9][0-9]*$"},
    "accelerators": {
      "type": "object",
      "required": ["vendor", "model", "count_per_node"],
      "properties": {
        "vendor": {"type": "string"},
        "model": {"type": "string"},
        "form_factor": {"type": "string"},
        "count_per_node": {"type": "integer", "minimum": 1},
        "memory_per_gpu_gib": {"type": "number", "exclusiveMinimum": 0},
        "intra_node_interconnect": {"type": "string"}
      }
    },
    "host": {"type": "object"},
    "network": {"type": "object"},
    "correction_log": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["revision", "summary"],
        "properties": {
          "revision": {"type": "integer", "minimum": 1},
          "summary": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
