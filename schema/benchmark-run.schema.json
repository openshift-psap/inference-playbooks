{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/openshift-psap/inference-playbooks/schema/benchmark-run.schema.json",
  "title": "Inference Playbook Benchmark Run",
  "type": "object",
  "required": [
    "schema_version", "run_id", "recipe_id", "deployment_scope",
    "hardware_profile", "hardware_profile_revision", "harness", "result", "artifacts"
  ],
  "properties": {
    "schema_version": {"enum": [1, 2]},
    "evidence_source": {"enum": ["forge-kpis", "local-guidellm", "local-aiperf"]},
    "forge": {"$ref": "#/$defs/forge"},
    "platform": {
      "type": "object",
      "required": ["stack", "version"],
      "properties": {
        "stack": {"type": "string"},
        "version": {"type": "string"}
      },
      "additionalProperties": false
    },
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "recipe_id": {"type": "string"},
    "deployment_scope": {"enum": ["single-node", "multi-node"]},
    "hardware_profile": {"type": "string", "pattern": "^hardware-profiles/.+\\.yaml$"},
    "hardware_profile_revision": {"type": "integer", "minimum": 1},
    "harness": {"type": "string"},
    "result": {"type": "string", "pattern": "^result\\.json$"},
    "command": {"type": "string"},
    "workload": {"type": "object"},
    "environment": {"type": "object"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/artifact"}
    }
  },
  "allOf": [
    {"if": {"properties": {"schema_version": {"const": 2}}, "required": ["schema_version"]},
     "then": {"required": ["evidence_source"]}},
    {"if": {"properties": {"evidence_source": {"const": "forge-kpis"}}, "required": ["evidence_source"]},
     "then": {"required": ["forge", "platform", "environment", "workload", "command"],
              "properties": {"schema_version": {"const": 2},
                "command": {"type": "string", "minLength": 1},
                "environment": {"required": ["model_revision", "image_digest"],
                  "properties": {"model_revision": {"type": "string", "minLength": 1,
                     "not": {"pattern": "[\\s\\u0000-\\u001f\\u007f]"},
                     "description": "Declared model revision exactly as supplied by Forge: main, a tag, branch, or commit hash. Must contain no whitespace or control characters; intake also applies the shared artifact privacy guard."},
                    "image_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}}}},
     "else": {"properties": {"forge": false}}}
  ],
  "$defs": {
    "forge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mlflow_tracking_uri", "mlflow_workspace", "mlflow_experiment_id",
                   "mlflow_parent_run_id", "mlflow_benchmark_run_id", "mlflow_run_url",
                   "pr_number", "tested_revision", "kpis_artifact_path", "kpis_checksum", "completeness"],
      "properties": {
        "mlflow_tracking_uri": {"type": "string", "pattern": "^https://"},
        "mlflow_workspace": {"type": "string", "minLength": 1},
        "mlflow_experiment_id": {"type": "string", "pattern": "^[0-9]+$"},
        "mlflow_parent_run_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
        "mlflow_benchmark_run_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
        "mlflow_run_url": {"type": "string", "pattern": "^https://"},
        "prow_job_id": {"type": "string"},
        "prow_job_url": {"type": "string", "pattern": "^https://"},
        "pr_number": {"type": "integer", "minimum": 1},
        "pr_comment_id": {"type": "integer", "minimum": 1},
        "tested_revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "kpis_artifact_path": {"type": "string", "minLength": 1},
        "kpis_checksum": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "completeness": {"enum": ["full-sweep", "smoke", "partial"]},
        "expected_concurrencies": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "guidellm": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
            "aiperf": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}}
          }
        }
      }
    },
    "artifact": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "raw-output",
            "log",
            "trace",
            "model-config",
            "harness-config",
            "metrics-export",
            "profile-snapshot",
            "other"
          ],
          "description": "What kind of artifact this is."
        },
        "path": {
          "type": "string",
          "description": "Relative path to a local artifact committed in the repository."
        },
        "uri": {
          "type": "string",
          "pattern": "^(s3://|gs://|mlflow://|https://).+",
          "description": "URI for an externally stored artifact (S3, GCS, MLflow, HTTPS)."
        },
        "checksum": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$",
          "description": "SHA-256 digest for integrity verification. Required for external artifacts."
        },
        "description": {
          "type": "string",
          "description": "Human-readable note about this artifact."
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0,
          "description": "Size of the artifact in bytes."
        }
      },
      "oneOf": [
        {
          "required": ["path"],
          "properties": {
            "uri": false
          }
        },
        {
          "required": ["uri", "checksum"],
          "properties": {
            "path": false
          }
        }
      ]
    }
  }
}
