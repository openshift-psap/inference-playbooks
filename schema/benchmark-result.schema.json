{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/openshift-psap/inference-playbooks/schema/benchmark-result.schema.json",
  "title": "Inference Playbook Normalized Benchmark Result",
  "type": "object",
  "required": ["schema_version", "run_id", "deployment_scope", "accelerator_key", "metrics"],
  "properties": {
    "schema_version": {"enum": [1, 2]},
    "run_id": {"type": "string"},
    "deployment_scope": {"enum": ["single-node", "multi-node"]},
    "accelerator_key": {"type": "string"},
    "metrics": {"type": "object"},
    "raw_metrics": {"type": "object"},
    "sweep": {
      "description": "Concurrency sweep results — one entry per concurrency level. Present in schema_version 2 results.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["concurrency"],
        "properties": {
          "concurrency": {"type": "integer", "minimum": 1},
          "ttft_ms_p50": {"type": "number"},
          "ttft_ms_p95": {"type": "number"},
          "itl_ms": {"type": "number"},
          "itl_ms_p95": {"type": "number"},
          "output_tok_s": {"type": "number"},
          "total_tok_s": {"type": "number"},
          "total_requests": {"type": "integer", "minimum": 0},
          "duration_seconds": {"type": "number"},
          "context_overflow_rate": {"type": "number", "minimum": 0, "maximum": 1},
          "failed_request_rate": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "additionalProperties": true
      }
    },
    "harness": {
      "description": "Benchmark harness identifier for UI display.",
      "type": "string"
    }
  }
}
