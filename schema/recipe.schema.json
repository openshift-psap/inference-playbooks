{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/openshift-psap/inference-playbooks/schema/recipe.schema.json",
  "title": "Inference Playbook Recipe",
  "type": "object",
  "required": [
    "schema_version", "recipe_id", "model_id", "platforms",
    "hardware_profile", "workload_profile", "deployment_mode",
    "optimization_intent", "maturity", "serving", "deployment"
  ],
  "$defs": {
    "status": {
      "type": "object",
      "required": ["state"],
      "properties": {
        "state": {"enum": ["verified", "derived", "needs-verification"]},
        "date": {"type": "string", "format": "date"},
        "method": {"type": "string"},
        "note": {"type": "string"},
        "derived_from": {"type": "string"}
      },
      "allOf": [
        {
          "if": {"properties": {"state": {"const": "verified"}}},
          "then": {"required": ["date", "method"]}
        },
        {
          "if": {"properties": {"state": {"const": "derived"}}},
          "then": {"required": ["derived_from"]}
        },
        {
          "if": {"properties": {"state": {"const": "needs-verification"}}},
          "then": {"required": ["note"]}
        }
      ]
    },
    "image_lifecycle": {
      "type": "object",
      "required": ["recommended"],
      "properties": {
        "recommended": {
          "type": "object",
          "required": ["ref", "status"],
          "properties": {
            "ref": {"type": "string", "minLength": 1},
            "status": {"$ref": "#/$defs/status"},
            "why": {"type": "string"}
          },
          "additionalProperties": false
        },
        "pin_for_disconnected": {
          "type": "object",
          "required": ["digest", "status"],
          "properties": {
            "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
            "status": {"$ref": "#/$defs/status"}
          },
          "additionalProperties": false
        },
        "target": {
          "type": "object",
          "description": "The image this recipe should converge to (e.g. RHAIIS image once it ships the required vLLM).",
          "required": ["ref", "status"],
          "properties": {
            "ref": {"type": "string", "minLength": 1},
            "status": {"$ref": "#/$defs/status"},
            "why": {"type": "string"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "image_usage": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["default", "custom"]},
        "variant": {"enum": ["cuda", "rocm", "cpu", "tpu", "spyre", "neuron", "gaudi", "omni"]},
        "note": {"type": "string", "pattern": "\\S"}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "custom"}}}, "then": {"required": ["note"]}},
        {"if": {"properties": {"kind": {"const": "default"}}}, "then": {"required": ["variant"]}}
      ],
      "additionalProperties": false
    },
    "probe_override": {
      "type": "object",
      "properties": {
        "path": {"type": "string"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "failure_threshold": {"type": "integer", "minimum": 1},
        "period_seconds": {"type": "integer", "minimum": 1},
        "timeout_seconds": {"type": "integer", "minimum": 1},
        "initial_delay_seconds": {"type": "integer", "minimum": 0},
        "why": {"type": "string"}
      },
      "additionalProperties": false
    },
    "exclude_entry": {
      "type": "object",
      "required": ["flag", "reason"],
      "properties": {
        "flag": {"type": "string", "pattern": "^--[a-z][a-z0-9-]*$"},
        "reason": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "role_block": {
      "type": "object",
      "properties": {
        "args": {
          "type": "array",
          "items": {"$ref": "#/$defs/serving/properties/args/items"}
        },
        "leader_args": {
          "type": "array",
          "items": {"$ref": "#/$defs/serving/properties/args/items"}
        },
        "worker_args": {
          "type": "array",
          "items": {"$ref": "#/$defs/serving/properties/args/items"}
        },
        "exclude": {
          "type": "array",
          "items": {"$ref": "#/$defs/exclude_entry"}
        }
      },
      "additionalProperties": false
    },
    "serving": {
      "type": "object",
      "required": ["image", "model", "parallelism", "args"],
      "properties": {
        "image": {
          "type": "string",
          "description": "Fully qualified container image reference. Must match image.recommended.ref when the image lifecycle block is present."
        },
        "engine": {"$ref": "engine-version.schema.json"},
        "image_usage": {"$ref": "#/$defs/image_usage"},
        "model": {
          "type": "string",
          "description": "HuggingFace model ID passed to vllm serve"
        },
        "served_model_name": {
          "type": "string",
          "description": "Model name for the /v1/models endpoint. Passed as --served-model-name to vLLM."
        },
        "parallelism": {
          "type": "object",
          "required": ["mode", "tp"],
          "properties": {
            "mode": {
              "enum": ["tp", "pp", "tp+pp", "dp", "tp+dp"]
            },
            "tp": {"type": "integer", "minimum": 1},
            "pp": {"type": "integer", "minimum": 1, "default": 1},
            "dp": {"type": "integer", "minimum": 1, "default": 1}
          },
          "additionalProperties": false
        },
        "resources": {
          "type": "object",
          "properties": {
            "requests": {
              "type": "object",
              "properties": {
                "cpu": {"type": "string"},
                "memory": {"type": "string"}
              }
            },
            "limits": {
              "type": "object",
              "properties": {
                "cpu": {"type": "string"},
                "memory": {"type": "string"}
              }
            }
          }
        },
        "env": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": {"type": "string"},
              "value": {"type": "string"},
              "value_from": {"type": "object"}
            },
            "oneOf": [
              {"required": ["value"]},
              {"required": ["value_from"]}
            ]
          }
        },
        "port": {
          "type": "integer",
          "default": 8000,
          "minimum": 1,
          "maximum": 65535
        },
        "router": {
          "type": "object",
          "properties": {
            "strategy": {"type": "string"},
            "values": {"type": "string", "pattern": "^config/.*\\.ya?ml$"}
          }
        },
        "args": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["flag", "required", "why"],
            "properties": {
              "flag": {"type": "string", "pattern": "^--[a-z][a-z0-9-]*$"},
              "value": {"type": "string"},
              "required": {"type": "boolean"},
              "why": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "constraint_overrides": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["flag", "allow", "reason"],
            "properties": {
              "flag": {"type": "string", "pattern": "^--[a-z][a-z0-9-]*$"},
              "allow": {"const": true},
              "reason": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "probes": {
          "type": "object",
          "description": "Override template probe defaults. Only specified fields override; others keep template values.",
          "properties": {
            "startup": {"$ref": "#/$defs/probe_override"},
            "readiness": {"$ref": "#/$defs/probe_override"},
            "liveness": {"$ref": "#/$defs/probe_override"}
          },
          "additionalProperties": false
        },
        "config_overrides": {
          "type": "boolean",
          "description": "Set true when config/ contains Kustomize overlay patches"
        },
        "decode": {"$ref": "#/$defs/role_block"},
        "prefill": {"$ref": "#/$defs/role_block"}
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "schema_version": {"const": 4},
    "recipe_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "model_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["stack", "version", "overrides"],
        "properties": {
          "stack": {"enum": ["rhoai", "llm-d", "vllm"]},
          "version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
          "overrides": {"type": "string", "pattern": "^platforms/[^/]+\\.ya?ml$"},
          "blocked": {"type": "boolean"},
          "reason": {"type": "string", "minLength": 1},
          "pinned_manifest": {
            "type": "string",
            "pattern": "^manifests/[^/]+/[^/]+\\.ya?ml$",
            "description": "Path to a hand-authored manifest that the renderer copies verbatim instead of generating."
          },
          "pinned_reason": {
            "type": "string",
            "minLength": 1,
            "description": "Why this platform uses a pinned manifest instead of the renderer."
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {"properties": {"blocked": {"const": true}}, "required": ["blocked"]},
            "then": {"required": ["stack", "version", "overrides", "reason"]}
          },
          {
            "if": {"required": ["pinned_manifest"]},
            "then": {"required": ["pinned_reason"]}
          }
        ]
      }
    },
    "hardware_profile": {
      "type": "string",
      "pattern": "^hardware-profiles/[a-z0-9][a-z0-9._-]+\\.yaml$"
    },
    "workload_profile": {
      "enum": ["guidellm-8k1k", "aiperf-agentx-128k", "aiperf-agentx-unlimited-context"]
    },
    "deployment_mode": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*(--[a-z0-9][a-z0-9-]*)?$"
    },
    "optimization_intent": {
      "type": "string",
      "minLength": 1,
      "description": "Catalog label. Use latency or throughput when applicable; custom text is allowed."
    },
    "maturity": {"enum": ["day-zero", "contributed", "validated", "production"]},
    "quantization": {
      "type": "string",
      "minLength": 1,
      "description": "Quantization variant name. Must match an entry in models/<model_id>/model.yaml quantizations[].name."
    },
    "image": {"$ref": "#/$defs/image_lifecycle"},
    "features": {
      "type": "object",
      "description": "Structured feature claims for catalog filtering. Validator cross-checks against serving.args.",
      "properties": {
        "tool_calling": {"type": "boolean"},
        "speculative_decoding": {"enum": [false, "mtp", "eagle", "draft-model", "ngram"]},
        "structured_output": {"type": "boolean"},
        "reasoning_parser": {"type": ["string", "boolean"]},
        "prefix_caching": {"type": "boolean"},
        "kv_cache_dtype": {"type": "string"}
      },
      "additionalProperties": false
    },
    "serving": {"$ref": "#/$defs/serving"},
    "deployment": {
      "type": "object",
      "required": ["scope"],
      "properties": {
        "scope": {"enum": ["single-node", "multi-node"]},
        "status": {"$ref": "#/$defs/status"},
        "storage": {
          "type": "object",
          "description": "Model weight storage configuration for the deployment.",
          "required": ["type"],
          "properties": {
            "type": {"enum": ["pvc", "nfs", "s3", "hostpath"]},
            "pvc": {
              "type": "object",
              "properties": {
                "name": {"type": "string", "minLength": 1},
                "size": {"type": "string", "pattern": "^[0-9]+[KMGTPE]i$"},
                "access_modes": {
                  "type": "array",
                  "minItems": 1,
                  "items": {"enum": ["ReadWriteOnce", "ReadWriteMany", "ReadOnlyMany"]}
                },
                "storage_class": {"type": "string"}
              },
              "additionalProperties": false
            },
            "why": {"type": "string"}
          },
          "additionalProperties": false
        },
        "manifests": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "kind"],
            "properties": {
              "path": {"type": "string", "pattern": "^manifests/"},
              "kind": {"type": "string"},
              "generated": {"type": "boolean"}
            }
          }
        }
      },
      "additionalProperties": false
    },
    "benchmark_runs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^results/.+/run\\.yaml$"}
    },
    "notes": {"type": "string", "pattern": "^guides/.*\\.ya?ml$"}
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"maturity": {"enum": ["validated", "production"]}}},
      "then": {"required": ["benchmark_runs", "image"]}
    }
  ]
}
