{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/openshift-psap/inference-playbooks/schema/model.schema.json",
  "title": "Inference Playbook Model Metadata",
  "type": "object",
  "required": ["schema_version", "model_id", "name", "family", "quantizations"],
  "properties": {
    "schema_version": {"enum": [1, 2]},
    "model_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "name": {"type": "string"},
    "family": {"type": "string"},
    "parameters": {"type": "string"},
    "huggingface_id": {"type": "string"},
    "license": {"type": "string"},
    "access": {"type": "object"},
    "source": {"enum": ["huggingface", "manual"]},
    "model_type": {"type": "string"},
    "architectures": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "quantizations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {"type": "string"},
          "huggingface_id": {"type": "string"}
        }
      }
    },
    "presentation": {
      "type": "object",
      "properties": {
        "icon_bg": {"type": "string"},
        "icon_letter": {"type": "string"},
        "provider": {"type": "string"},
        "tags": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "if": {
    "properties": {"schema_version": {"const": 2}},
    "required": ["schema_version"]
  },
  "then": {
    "required": ["schema_version", "model_id", "name", "family", "quantizations",
                  "huggingface_id", "model_type", "architectures", "source"]
  }
}
